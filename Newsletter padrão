<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PopVerse Newsletter</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:'Inter', sans-serif;

    background:
    radial-gradient(circle at top left,#ff006e 0%,transparent 30%),
    radial-gradient(circle at bottom right,#3a86ff 0%,transparent 35%),
    #0b0b14;

    overflow:hidden;
}

/* Bolhas decorativas */

body::before,
body::after{
    content:"";
    position:absolute;
    border-radius:50%;
    filter:blur(100px);
    animation:float 8s ease-in-out infinite;
}

body::before{
    width:350px;
    height:350px;
    background:#ff006e;
    top:-120px;
    left:-120px;
}

body::after{
    width:300px;
    height:300px;
    background:#8338ec;
    right:-100px;
    bottom:-100px;
}

@keyframes float{
    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-25px);
    }
}

/* Card */

.newsletter{
    width:90%;
    max-width:700px;

    padding:3rem;

    background:rgba(255,255,255,.08);

    backdrop-filter:blur(20px);

    border:1px solid rgba(255,255,255,.12);

    border-radius:28px;

    text-align:center;

    box-shadow:
    0 20px 50px rgba(0,0,0,.35);

    animation:fadeUp 1s ease;
}

@keyframes fadeUp{

    from{
        opacity:0;
        transform:translateY(40px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

.logo{

    width:120px;
    height:120px;

    border-radius:50%;

    object-fit:cover;

    border:4px solid rgba(255,255,255,.15);

    margin-bottom:1.5rem;

    transition:.4s;
}

.logo:hover{

    transform:rotate(8deg) scale(1.05);

}

h1{

    color:white;

    font-size:clamp(2rem,5vw,4rem);

    font-weight:800;

    margin-bottom:1rem;
}

.highlight{

    background:linear-gradient(
    90deg,
    #ff006e,
    #8338ec,
    #3a86ff
    );

    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

p{

    color:#d8d8d8;

    font-size:1.1rem;

    line-height:1.7;

    margin-bottom:2rem;
}

/* Form */

.form{

    display:flex;

    gap:1rem;

    justify-content:center;

    flex-wrap:wrap;
}

input[type="email"]{

    flex:1;

    min-width:250px;

    padding:16px 20px;

    border:none;

    border-radius:14px;

    background:rgba(255,255,255,.08);

    color:white;

    font-size:1rem;

    outline:none;

    transition:.3s;
}

input[type="email"]:focus{

    box-shadow:0 0 0 3px #8338ec;
}

button{

    padding:16px 28px;

    border:none;

    border-radius:14px;

    cursor:pointer;

    font-weight:700;

    font-size:1rem;

    color:white;

    background:linear-gradient(
    90deg,
    #ff006e,
    #8338ec
    );

    transition:.3s;
}

button:hover{

    transform:translateY(-3px);

    box-shadow:
    0 10px 30px rgba(131,56,236,.4);

}

.badges{

    margin-top:2rem;

    display:flex;

    justify-content:center;

    gap:1rem;

    flex-wrap:wrap;
}

.badge{

    background:rgba(255,255,255,.06);

    color:#e5e5e5;

    padding:.6rem 1rem;

    border-radius:999px;

    font-size:.9rem;
}

@media(max-width:600px){

    .newsletter{

        padding:2rem;
    }

    .form{

        flex-direction:column;
    }

    button{

        width:100%;
    }
}

</style>

</head>

<body>

<div class="newsletter">

    <img
    class="logo"
    src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=400"
    alt="PopVerse">

    <h1>
        POP<span class="highlight">VERSE</span>
    </h1>

    <p>
        Receba semanalmente novidades sobre filmes,
        séries, games, quadrinhos, animação,
        streaming, IA criativa e cultura geek.
    </p>

    <form class="form">

        <input
        type="email"
        placeholder="Digite seu melhor e-mail">

        <button>
            Entrar na Comunidade
        </button>

    </form>

    <div class="badges">

        <span class="badge">🎬 Cinema</span>

        <span class="badge">🎮 Games</span>

        <span class="badge">📚 HQs</span>

        <span class="badge">📺 Séries</span>

        <span class="badge">🤖 IA Criativa</span>

    </div>

</div>

</body>
</html>
